# Copy to ~/.mdr-tracker.env and edit there; do not put real settings in Git.
TRACKER_REPO="$HOME/mdr_race_tracker"
# Confirm the executable reports Python 3.11+ using python3 --version.
TRACKER_PYTHON="/usr/bin/python3"
TRACKER_GOOGLE_DOC="YOUR_GOOGLE_DOC_ID_OR_URL"
# Optional separate document for director commands; editing access only for race staff.
# TRACKER_DIRECTOR_DOC="YOUR_RACE_DIRECTOR_DOC_URL"
# Assumes llamasystem.org uses ~/llamasystem.org as its web directory.
# Check the actual website directory in DreamHost's panel before running.
TRACKER_WEB_ROOT="$HOME/llamasystem.org/mdr/moreau"
TRACKER_DATABASE="$HOME/mdr-tracker-data/moreau-test.sqlite3"
# Leave these unset for the existing fictional Moreau test.
# For race day, use the actual date/start, roster and a separate database.
# TRACKER_CONFIG="$TRACKER_REPO/races/moreau-2026/race.local.json"
# TRACKER_ROSTER="$TRACKER_REPO/races/moreau-2026/roster.json"
# TRACKER_GOOGLE_TOKEN="$HOME/mdr-tracker-data/google-token.json"

# Optional sweeper GPS from a public Garmin MapShare page.
# TRACKER_SWEEPER_URL="https://share.garmin.com/4YNCH"
